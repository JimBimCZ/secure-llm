# Copy to .env before running: cp .env.example .env
# .env is git-ignored. Never commit real values.
#
# The secrets below are WORKING local-development credentials, not inert
# placeholders. They have to work: `cp .env.example .env && docker compose up`
# is required to bring the whole stack up with no manual step, so a value that
# needed editing first would break that promise. They are safe to commit only
# because everything they unlock is a container on your own machine.
#
# Before this runs anywhere that is not your laptop, regenerate all five:
#
#   AUTH_SECRET             openssl rand -base64 32   <- see the warning below
#   POSTGRES_PASSWORD       and the copy inside DATABASE_URL   <- caveat below
#   OIDC_CLIENT_SECRET      and the copy inside infra/keycloak/realm.json
#   KEYCLOAK_ADMIN_PASSWORD
#
# Every one of them is spelled `local-dev-only-change-me-*`, so `grep -rn
# local-dev-only-change-me .` finds anything still left at its default.

# --- Database -----------------------------------------------------------
# Used by the postgres container to initialise itself.
POSTGRES_USER=pkb
# CAVEAT: Postgres reads this only while initialising an EMPTY data directory.
# Against an existing `db-data` volume a new value is simply ignored, so the
# database keeps the old password, stays healthy, and the app fails to connect
# with an authentication error that looks nothing like a stale volume. Dropping
# the volume is what applies it: `docker compose down -v`, which also destroys
# every document stored locally. A fresh clone has no volume and never sees it.
POSTGRES_PASSWORD=local-dev-only-change-me-postgres
POSTGRES_DB=pkb

# Used by the app. Host is the compose service name, not localhost.
#
# COUPLED: the password here is the same secret as POSTGRES_PASSWORD above, and
# nothing checks that the two agree. Change one without the other and Postgres
# starts fine, then the app fails to connect with an authentication error that
# points at neither line. Kept as one explicit variable rather than assembled by
# compose from the parts, because the app also has to run outside compose, and a
# connection string built differently depending on how you launched it is worse
# to explain than a duplicated password with a warning on it.
DATABASE_URL=postgres://pkb:local-dev-only-change-me-postgres@db:5432/pkb

# --- Logging ------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Identity (OIDC) ----------------------------------------------------
# No provider name appears anywhere in the code. To swap the local mock IdP
# for Microsoft Entra ID, change the five OIDC_* values below and drop
# OIDC_INTERNAL_ORIGIN. See README → "Swapping the IdP".

# Session cookie encryption. Generate a real one with: openssl rand -base64 32
#
# THIS ONE IS NOT LIKE THE OTHERS. The other secrets in this file gate a
# container on your own machine; the worst a leak does is let someone reach a
# local Postgres. This value is the key the session cookie is encrypted and
# signed with, so anyone holding it can MINT A VALID SESSION FOR ANY USER
# without ever touching the identity provider. Deployed with the value below —
# which is published in this repository — the application has no authentication
# at all. Minimum 16 characters, enforced by the env schema.
AUTH_SECRET=local-dev-only-change-me-auth-secret-min-16-chars
AUTH_URL=http://localhost:3000

# The issuer as the BROWSER sees it. This is what lands in the token's `iss`.
OIDC_ISSUER=http://localhost:8080/realms/pkb
OIDC_CLIENT_ID=pkb-app
# COUPLED: this must equal the `secret` of the `pkb-app` client in
# infra/keycloak/realm.json, which is what the mock IdP imports at startup.
# Change it here alone and sign-in fails at the token exchange with an OAuth
# error that never mentions the realm file. Against a real IdP the secret is
# issued by the IdP and this coupling disappears.
OIDC_CLIENT_SECRET=local-dev-only-change-me-client-secret
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=roles

# Local-Docker only: the server reaches Keycloak on the container network,
# while the browser reaches it on localhost. Unset this for a public IdP.
OIDC_INTERNAL_ORIGIN=http://keycloak:8080

# --- Local mock IdP (Keycloak) ------------------------------------------
# Console at http://localhost:8080. Not used by the app itself.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-change-me-keycloak-admin

# --- Embeddings ---------------------------------------------------------
# local = model runs in-process, no text leaves the app to be embedded.
# mock  = deterministic hashing, no model. Retrieval degrades to keyword
#         matching, which is what makes the app demoable with no model present.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./.models

# --- Answering (LLM) ----------------------------------------------------
# mock       = no key, no network. Extracts the best-matching sentences from the
#              retrieved chunks and cites them. The default, so `docker compose
#              up` is fully demoable with nothing configured.
# openrouter = a real third-party AI gateway. Requires OPENROUTER_API_KEY, and
#              LLM_MODEL must be an OpenRouter model id (namespaced).
# anthropic  = the vendor's API directly. Requires ANTHROPIC_API_KEY.
# gateway    = any other Anthropic-compatible gateway. Requires
#              LLM_GATEWAY_BASE_URL.
#
# Changing this line is the ONLY change needed to move between them. Remember to
# set LLM_MODEL to an id that provider recognises.
LLM_PROVIDER=mock

# Model id, in the selected provider's namespace. Same model, different route:
#   anthropic  -> claude-opus-5
#   openrouter -> anthropic/claude-opus-5
LLM_MODEL=claude-opus-5

# Wall-clock deadline for one model call. The request is aborted, not abandoned.
LLM_TIMEOUT_MS=60000

# Leave blank unless LLM_PROVIDER=openrouter. Never commit a real key.
OPENROUTER_API_KEY=

# Leave blank unless LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Leave blank unless LLM_PROVIDER=gateway. The gateway holds the vendor key;
# LLM_GATEWAY_API_KEY authenticates this app TO the gateway.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=

# --- Retrieval ----------------------------------------------------------
# How many chunks are put in front of the model.
RAG_TOP_K=6
# Cosine similarity floor. Below this the app answers "Not found in your
# knowledge base." rather than passing weak matches to the model.
RAG_MIN_SCORE=0.25

# --- Retention ----------------------------------------------------------
# How long an LLM audit record (model, time, tokens, latency, outcome) is kept.
# Purged on startup and hourly. Set this to 0, restart, and every row is gone
# — the policy is demonstrable, not just documented.
# Application and auth logs go to stdout: this process never stores them, so
# their retention belongs to whatever collects the container's output.
RETENTION_AUDIT_DAYS=30
